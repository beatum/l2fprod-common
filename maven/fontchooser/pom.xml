<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <parent>
    <artifactId>l2fprod-common-all</artifactId>
    <groupId>com.l2fprod.common</groupId>
    <version>7.4-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.l2fprod.common</groupId>
  <artifactId>l2fprod-common-fontchooser</artifactId>
  <name>fontchooser</name>
  <version>7.4-SNAPSHOT</version>
  <description>fontchooser</description>
  <build>
    <!-- standard Maven layout: sources under src/main/java and resources under src/main/resources -->
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <compress>true</compress>
            <manifest>
              <mainClass>com.l2fprod.common.demo.Main</mainClass>
              <addExtensions>false</addExtensions>
              <addClasspath>true</addClasspath>
            </manifest>
            <manifestSections />
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <dependencies>
    <dependency>
      <groupId>com.l2fprod.common</groupId>
      <artifactId>l2fprod-common-shared</artifactId>
      <version>7.4-SNAPSHOT</version>
      <scope>compile</scope>
    </dependency>
  </dependencies>
</project>
