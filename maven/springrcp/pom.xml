<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <parent>
    <artifactId>l2fprod-common-all</artifactId>
    <groupId>com.l2fprod.common</groupId>
    <version>7.4-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.l2fprod.common</groupId>
  <artifactId>l2fprod-common-springrcp</artifactId>
  <name>springrcp</name>
  <version>7.4-SNAPSHOT</version>
  <description>springrcp</description>
  <build>
    <!-- standard Maven layout: sources under src/main/java and resources under src/main/resources -->
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <compress>true</compress>
            <manifest>
              <mainClass />
              <addExtensions>false</addExtensions>
              <addClasspath>true</addClasspath>
            </manifest>
            <manifestSections />
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-install-plugin</artifactId>
        <version>2.5</version>
        <executions>
            <execution>
                <id>spring-richclient</id>
                <phase>initialize</phase>
                <goals>
                    <goal>install-file</goal>
                </goals>
                <configuration>
                  <groupId>org.springframework</groupId>
                  <artifactId>spring-richclient</artifactId>
                  <version>2006.02.19</version>
                  <packaging>jar</packaging>
                  <file>../../lib/spring/spring-richclient.jar</file>
                </configuration>
            </execution>
            <execution>
                <id>spring</id>
                <phase>initialize</phase>
                <goals>
                    <goal>install-file</goal>
                </goals>
                <configuration>
                  <groupId>org.springframework</groupId>
                  <artifactId>spring</artifactId>
                  <version>1.2.5</version>
                  <packaging>jar</packaging>
                  <file>../../lib/spring/spring.jar</file>
                </configuration>
            </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <dependencies>
    <dependency>
      <groupId>com.l2fprod.common</groupId>
      <artifactId>l2fprod-common-tasks</artifactId>
      <version>7.4-SNAPSHOT</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>com.l2fprod.common</groupId>
      <artifactId>l2fprod-common-directorychooser</artifactId>
      <version>7.4-SNAPSHOT</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-richclient</artifactId>
      <version>2006.02.19</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring</artifactId>
      <version>1.2.5</version>
      <scope>compile</scope>
    </dependency>
  </dependencies>
</project>
